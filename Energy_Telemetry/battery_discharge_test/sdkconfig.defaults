CONFIG_IDF_TARGET="esp32"

# Tick de 1 ms: o polling do bit OS do ADS1115 usa vTaskDelay(pdMS_TO_TICKS(1)),
# que com o tick padrao de 10 ms truncaria para 0 tick.
CONFIG_FREERTOS_HZ=1000

# Task watchdog com panic: se a task de aquisicao travar, a ESP32 reinicia.
# No reset o GPIO23 volta a alta impedancia -> carga desabilitada pelo
# pull externo do pino de enable (ver README).
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Console serial a 115200 (usado pelo battery_monitor.py via cabo)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Buffers de formatacao/BT: pilha maior para a task principal
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash de 4 MB e tabela de particoes propria (NVS + app + particao "blog" para o log)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bluetooth Classic (SPP) apenas, sem BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
