CONFIG_IDF_TARGET="esp32"

# Log padrao em Info; reduza para Warn se o output do monitor ficar poluido
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Modulo ESP32-WROOM-32D com 4 MB de flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Tick de 1 ms, como na base de testes: o polling do bit OS do ADS1115
# usa vTaskDelay(pdMS_TO_TICKS(1)), que vira 0 tick a 100 Hz.
CONFIG_FREERTOS_HZ=1000
